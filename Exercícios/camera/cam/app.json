{
  "expo": {
    "name": "Câmera",
    "slug": "cam",
    "version": "26.03.2201",
    "orientation": "portrait",
    "icon": "./assets/cam.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/cam.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa acessar a câmera para tirar fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/cam_foreground.png",
        "backgroundImage": "./assets/cam_round.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
     "plugins": [
      "expo-camera"
    ]
  }
}
